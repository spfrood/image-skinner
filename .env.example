RUNPOD_API_KEY=your_runpod_api_key_here

# Pod configuration
RUNPOD_GPU_TYPE=NVIDIA GeForce RTX 4090
RUNPOD_CONTAINER_IMAGE=runpod/pytorch:2.1.0-py3.10-cuda11.8.0-devel-ubuntu22.04
RUNPOD_DISK_SIZE_GB=50
RUNPOD_VOLUME_SIZE_GB=20

# File transfer — choose "runpod" (pod file API) or "s3"
TRANSFER_BACKEND=runpod

# Required only when TRANSFER_BACKEND=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=solostudio-transfers
S3_REGION=us-east-1

# Local paths
ASSETS_DIR=assets
RECORDINGS_DIR=assets/recordings
OUTPUTS_DIR=assets/outputs
CHARACTERS_DIR=assets/characters

# API server
API_HOST=0.0.0.0
API_PORT=8000
